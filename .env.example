[TEMPLATE]
GROQ_API_KEY=paste_your_groq_key_here
# Optional: override the Groq chat model (default qwen/qwen3.8-27b)
# GROQ_MODEL=qwen/qwen3.8-27b
# Optional: local on-device fallback, used only when the cloud is unreachable.
# Requires Ollama running (https://ollama.com) with the model pulled.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
#
# ---- Local-first / offline mode -------------------------------------------
# Set ARIA_OFFLINE=1 to run the whole product with the network disabled:
# STT uses on-device faster-whisper, LLM uses local Ollama, TTS uses Kokoro.
# The cloud is never contacted in this mode (enforced, not advisory).
# ARIA_OFFLINE=0
# Optional: local whisper size (tiny/base/small — default small, ~460 MB,
# downloaded on first offline use and cached)
# LOCAL_STT_MODEL=small
# Optional: hard per-call cloud timeouts (seconds)
# LLM_TIMEOUT=120
# STT_TIMEOUT=60
# Optional: relocate the local practice-history database
# ARIA_DB=D:\path\to\aria_history.db
#
# ---- Session length -------------------------------------------------------
# How many questions one mock interview contains. This is the single named
# constant (coach.INTERVIEW_LENGTH): the prompt, the truncation and the number
# shown in the UI header all read it, so they cannot drift apart. Default 6.
# ARIA_INTERVIEW_LENGTH=6
